# Server Configuration
PORT=8080
ENV=development

# Database Configuration (Supabase or Local PostgreSQL)
# Example Supabase: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Example Local: postgres://postgres:postgres@localhost:5432/baki?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/baki?sslmode=disable

# Authentication
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRATION_HOURS=72

# Paystack API & Webhooks
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret
PAYSTACK_CALLBACK_URL=http://localhost:8080/api/v1/payments/verify
